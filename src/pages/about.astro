---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import Asciiart from "../components/Asciiart.astro";

const skills = [
  "astro",
  "nestjs",
  "python",
  "typescript",
  "javascript",
  "java",
  "spring",
  "postgresql",
  "mysql",
  "mongodb",
  "cloudflare",
  "linux",
];
---

<Layout title="About Rodrigo" description="Learn more about me, a software engineer with experience in backend and full-stack development." keywords="Rodrigo Jose,about,software engineer,backend,fullstack">
  <div class="about-background absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="about-grid absolute inset-0 opacity-10"
      style="
          background-image: radial-gradient(white 1px, transparent 1px);
          background-size: 20px 20px;
          mask-image: 
            radial-gradient(circle at 20% 30%, black 0%, transparent 40%),
            radial-gradient(circle at 80% 70%, black 0%, transparent 35%),
            radial-gradient(circle at 50% 10%, black 0%, transparent 25%);
          -webkit-mask-image: 
            radial-gradient(circle at 20% 30%, black 0%, transparent 40%),
            radial-gradient(circle at 80% 70%, black 0%, transparent 35%),
            radial-gradient(circle at 50% 10%, black 0%, transparent 25%);
        "
    >
    </div>
  </div>
  <section id="about" class="flex flex-col md:flex-row w-full gap-12 mb-10">
    <div
      class="flex flex-col items-center md:items-start justify-center w-full text-gray-100"
    >
      <div
        class="flex gap-8 items-center text-4xl font-medium text-pretty p-4 font-mono"
      >
        <Icon name="mdi:person" />
        <h1>About me</h1>
      </div>
      <p
        class="text-pretty mt-2 text-gray-100 md:w-1/2 w-3/4 font-mono text-lg text-whiterounded"
      >
        My name is Rodrigo! I'm a Back-end Developer/Software Engineer. I've
        been studying programming since I was 12 years old and I'm currently
        pursuing a degree in Computer Science at Anhembi Morumbi University
        (UAM)
        <span
          class="inline-block h-5 w-2 bg-gray-100 animate-pulse align-middle ml-1"
        ></span>
      </p>
    </div>
    <div
      class="flex items-center justify-center w-full md:w-1/4 opacity-35"
      transition:animate="slide"
    >
      <Asciiart />
    </div>
  </section>

  <section
    id="education"
    class="flex w-full flex-col gap-5 py-6 text-gray-200 md:flex-row md:items-center md:justify-between md:gap-10"
  >
    <div class="flex shrink-0 items-center gap-4 font-mono text-2xl font-medium">
      <Icon name="mdi:school-outline" />
      <h2>Education</h2>
    </div>
    <div class="flex w-full flex-col gap-1 font-mono md:max-w-2xl md:flex-row md:items-center md:justify-between md:gap-8">
      <div>
        <h3 class="font-bold text-white">Computer Science</h3>
        <p class="text-neutral-300">Anhembi Morumbi University (UAM)</p>
      </div>
      <span class="text-sm text-neutral-500">02/2025 - Present</span>
    </div>
  </section>

  <section
    id="skills"
    class="flex flex-col md:flex-row-reverse items-center justify-center w-full mb-10 mt-10 text-gray-300"
  >
    <div
      class="flex flex-col items-center md:items-end justify-center text-gray-200"
    >
      <div
        class="flex gap-8 items-center text-4xl font-medium text-pretty p-4 font-mono"
      >
        <h1>Skills</h1>
        <Icon name="mdi:spider-web" />
      </div>
      <p
        class="text-pretty mt-2 text-gray-100 md:w-1/2 w-3/4 font-mono text-lg text-whiterounded"
      >
        I am passionate about exploring technology and teaching myself new
        languages. Currently, I am deepening my knowledge in Programming,
        Cybersecurity, and Pentesting. To support my international growth, I am
        focused on mastering English, with plans to challenge myself with
        Mandarin in the future.
        <span
          class="inline-block h-5 w-2 bg-gray-100 animate-pulse align-middle ml-1"
        ></span>
      </p>
    </div>
    <div
      class="w-full text-gray-200 flex flex-col mt-10 md:mt-0 md:flex-col md:items-start items-center justify-center gap-4"
      transition:animate="slide"
    >
      <div>
        <span class="font-mono text-neutral-500">languages:</span>
        <ul class="flex flex-col text-neutral-200">
          <li class="flex gap-4">
            Japanse:<p class="font-bold text-white">N5(Basic)</p>
          </li>
          <li class="flex gap-4">
            English:<p class="font-bold text-white">Advanced</p>
          </li>
        </ul>
      </div>
      <div>
        <span class="font-mono text-neutral-500">stacks:</span>
        <ul class="text-2xl flex flex-wrap gap-2">
          {
            skills.map((skill) => (
              <li>
                <Icon name={`devicon-plain:${skill}`} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-grid {
    animation: about-grid-drift 28s linear infinite;
  }

  @keyframes about-grid-drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(20px, 20px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-grid {
      animation: none;
    }
  }
</style>
