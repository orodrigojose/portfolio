---
import { Icon } from "astro-icon/components";
---

<div
  class="hidden absolute flex items-center justify-center z-40 left-0 top-0 w-full h-full backdrop-blur-3xl shadow-2xl bg-neutral-950/80"
  id="modal-container"
>
  <div
    class="flex flex-col w-[400px] min-h-36 bg-neutral-900 border-2 border-neutral-700 shadow-2xl rounded-lg overflow-hidden"
    id="modal-content"
  >
    <header class="flex items-center justify-between gap-10h-1/3 relative">
      <span
        class="absolute z-10 text-lg px-4 py-1.5 bottom-2 font-mono font-extrabold text-gray-100"
        id="modal-title"></span>
      <div
        class="relative z-0 w-full h-30 overflow-hidden brightness-45 border-b-2 border-b-neutral-500/20 shadow-lg"
      >
        <img class="object-cover" src="/projects/senju.png" id="modal-image" />
      </div>
      <a
        class="absolute top-2 right-8 z-30 text-white cursor-pointer flex justify-center items-center gap-2 text-xl hover:brightness-70 transition-all hover:scale-105"
        id="modal-preview"><Icon name="mdi:earth" /></a
      >
      <button
        class="absolute top-2 right-2 z-30 text-white cursor-pointer text-xl hover:brightness-70 transition-all hover:scale-105"
        id="close-modal"
      >
        <Icon name="mdi:close" />
      </button>
    </header>
    <main
      class="flex flex-col items-center justify-center w-full h-full text-gray-200 p-2"
    >
      <p id="modal-description" class="text-pretty p-2 text-neutral-300"></p>
      <div class="flex items-center justify-between w-full"></div>
    </main>
  </div>
</div>
