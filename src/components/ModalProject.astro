---
import { Icon } from "astro-icon/components";
---

<div
  class="absolute flex items-center justify-center z-40 left-0 top-0 w-full h-full backdrop-blur-3xl shadow-2xl bg-neutral-950/80"
  id="modal-container"
>
  <div
    class="flex flex-col w-[400px] min-h-36 bg-neutral-800 border-2 border-neutral-700 shadow-2xl rounded-lg overflow-hidden"
    id="modal-content"
  >
    <header class="flex items-center justify-between gap-10h-1/3 relative">
      <span
        class="absolute z-10 text-lg px-4 py-1.5 bottom-2 font-mono font-extrabold text-gray-100"
        id="modal-title"></span>
      <div
        class="relative z-0 w-full h-30 overflow-hidden brightness-45 border-b-2 border-b-neutral-500/20 shadow-lg"
      >
        <img class="object-cover" src="/projects/senju.png" id="modal-image" />
      </div>
      <button
        class="absolute top-2 right-2 z-30 text-white cursor-pointer"
        id="close-modal"
      >
        <Icon name="mdi:close" />
      </button>
    </header>
    <main
      class="flex flex-col items-center justify-center w-full h-full text-gray-200"
    >
      <p id="modal-description" class="text-pretty p-2 text-neutral-300">
        fjadlfjdska fjdlsajfdlsafj sal fjslakjfsa fjadlfjdska fjdlsajfdlsafj sal
        fjslakjfsa fjadlfjdska fjdlsajfdlsafj sal fjslakjfsa fjadlfjdska
        fjdlsajfdlsafj sal fjslakjfsa fjadlfjdska fjdlsajfdlsafj sal fjslakjfsa
        fjadlfjdska fjdlsajfdlsafj sal fjslakjfsa fjadlfjdska fjdlsajfdlsafj sal
        fjslakjfsa
      </p>
      <div class="flex items-center justify-between w-full">
        <a
          class="flex items-center justify-center bg-gray-500 border-2 border-gray-500 p-1 w-full"
          id="modal-preview"><Icon name="mdi:arrow-right" />Go App</a
        >
      </div>
    </main>
  </div>
</div>
