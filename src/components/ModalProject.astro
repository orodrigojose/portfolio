---
import { Icon } from "astro-icon/components";
---

<div
  class="fixed inset-0 z-50 grid h-dvh w-full place-items-center overflow-y-auto bg-neutral-950/60 p-4 opacity-0 pointer-events-none backdrop-blur-sm transition-all duration-300 ease-out sm:p-6"
  id="modal-container"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-describedby="modal-description"
  aria-hidden="true"
>
  <div
    class="relative my-auto max-h-[calc(100dvh-2rem)] w-full max-w-xl scale-95 overflow-y-auto border border-white/15 bg-neutral-950/95 opacity-0 shadow-2xl backdrop-blur-md transition-all duration-300 sm:max-h-[calc(100dvh-3rem)]"
    id="modal-content"
  >
    <header class="group relative h-44 overflow-hidden sm:h-60">
      <div
        class="absolute inset-0 bg-linear-to-t from-neutral-900 to-transparent z-10"
      >
      </div>
      <img
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        src="/projects/senju.png"
        id="modal-image"
        alt="Project Preview"
      />

      <div class="absolute top-4 right-4 z-20 flex gap-2">
        <a
          id="modal-preview"
          href="#"
          target="_blank"
          class="border border-white/10 bg-white/10 p-2 text-white backdrop-blur-md transition-all hover:scale-110 hover:bg-white/20"
          title="Visit project"
        >
          <Icon name="mdi:earth" class="w-5 h-5" />
        </a>
        <button
          id="close-modal"
          type="button"
          aria-label="Close project details"
          class="cursor-pointer border border-white/10 bg-white/10 p-2 text-white backdrop-blur-md transition-all hover:scale-110 hover:bg-white/20"
          title="Close"
        >
          <Icon name="mdi:close" class="w-5 h-5" />
        </button>
      </div>

      <div class="absolute bottom-6 left-6 z-20">
        <h3
          class="text-2xl font-bold text-white tracking-tight font-mono"
          id="modal-title"
        >
        </h3>
      </div>
    </header>

    <main class="p-5 pt-3 sm:p-6 sm:pt-3">
      <p
        id="modal-description"
        class="text-neutral-300 leading-relaxed mb-6 font-light text-sm sm:text-base"
      >
      </p>

      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <span
            class="text-xs font-mono uppercase tracking-widest text-neutral-500"
            >Stacks</span
          >
          <div
            id="modal-stacks-container"
            class="flex flex-wrap gap-2 text-neutral-400"
          >
            <!-- Stacks will be injected here -->
          </div>
        </div>

        <a
          id="modal-visit"
          href="#"
          target="_blank"
          class="group mt-4 flex w-full items-center justify-center gap-2 bg-white px-4 py-3 text-sm font-bold text-black transition-colors hover:bg-neutral-200"
        >
          VISIT PROJECT
          <Icon
            name="mdi:arrow-right"
            class="w-4 h-4 transition-transform group-hover:translate-x-1"
          />
        </a>
      </div>
    </main>
  </div>
</div>

<style>
  #modal-container.is-open {
    @apply opacity-100 pointer-events-auto;
  }

  #modal-container.is-open #modal-content {
    @apply scale-100 opacity-100;
  }
</style>
