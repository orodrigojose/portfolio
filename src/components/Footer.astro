---
import { Icon } from "astro-icon/components";

interface Social {
  title: string;
  link: string;
}

const socials = [
  { title: "github", link: "https://github.com/orodrigojose" },
  { title: "linkedin", link: "https://linkedin.com/in/orodrigojose" },
];
---

<footer
  class="relative flex items-center justify-center text-neutral-500 py-16 px-6 overflow-hidden border-t-2 border-neutral-600/20 group mt-25"
>

  <div class="relative max-w-7xl mx-auto z-10 font-mono">
    <div>
      <span>Rodrigo Jose - 2026 &copy;</span>
    </div>
    <ul class="flex gap-4 border-t-2 border-t-neutral-800/40 p-2">
      {
        socials.map((social: Social, index: number) => (
          <a
            href={social.link}
            class="text-lg hover:text-white hover:scale-105 transition-all"
          >
            <Icon name={`mdi:${social.title}`} />
          </a>
        ))
      }
    </ul>
  </div>

  <script>
    function initHackingNetwork() {
      const canvas = document.getElementById(
        "hackingNetworkCanvas",
      ) as HTMLCanvasElement;
      if (!canvas) return;

      const ctx = canvas.getContext("2d");
      const nodeCountDisplay = document.getElementById("nodeCount");
      let width, height;
      let particles = [];
      const properties = {
        bgColor: "rgba(0, 0, 0, 1)",
        particleColor: "rgba(255, 255, 255, 0.7)",
        lineColor: "rgba(255, 255, 255, 0.15)",
        particleRadius: 1.5,
        particleCount: Math.floor(
          (window.innerWidth * window.innerHeight) / 10000,
        ),
        particleMaxVelocity: 0.3,
        lineLength: 150,
      };

      if (nodeCountDisplay)
        nodeCountDisplay.innerText = String(properties.particleCount);

      function resizeCanvas() {
        width = canvas.width = (
          canvas.parentElement as HTMLElement
        ).offsetWidth;
        height = canvas.height = (
          canvas.parentElement as HTMLElement
        ).offsetHeight;
      }

      let mouse = { x: null, y: null };
      window.addEventListener("mousemove", (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });

      window.addEventListener("mouseout", () => {
        mouse.x = null;
        mouse.y = null;
      });

      class Particle {
        x: number;
        y: number;
        velocityX: number;
        velocityY: number;

        constructor() {
          this.x = Math.random() * width;
          this.y = Math.random() * height;
          this.velocityX =
            (Math.random() - 0.5) * properties.particleMaxVelocity;
          this.velocityY =
            (Math.random() - 0.5) * properties.particleMaxVelocity;
        }

        position() {
          // Movimento básico
          this.x += this.velocityX;
          this.y += this.velocityY;

          // Rebater nas bordas
          if (this.x >= width || this.x <= 0) this.velocityX *= -1;
          if (this.y >= height || this.y <= 0) this.velocityY *= -1;
        }

        draw() {
          ctx.beginPath();
          ctx.arc(
            this.x,
            this.y,
            properties.particleRadius,
            0,
            Math.random() * Math.PI * 2,
          );
          ctx.closePath();
          ctx.fillStyle = properties.particleColor;

          // Efeito visual aleatório: alguns nós piscam
          if (Math.random() > 0.98) {
            ctx.fillStyle = "rgba(255, 255, 255, 1)";
            ctx.arc(
              this.x,
              this.y,
              properties.particleRadius * 1.5,
              0,
              Math.PI * 2,
            );
          }

          ctx.fill();
        }
      }

      // Desenhar as linhas de conexão
      function drawLines() {
        let x, y, dist;
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            x = particles[i].x - particles[j].x;
            y = particles[i].y - particles[j].y;
            dist = Math.sqrt(x * x + y * y);

            // Se a distância for menor que o máximo, desenha a linha
            if (dist < properties.lineLength) {
              // A opacidade aumenta quando os pontos estão mais próximos
              let opacity = 1 - dist / properties.lineLength;
              ctx.lineWidth = 0.5;
              ctx.strokeStyle = `rgba(255, 255, 255, ${opacity * 0.2})`;

              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.closePath();
              ctx.stroke();
            }
          }

          if (mouse.x !== null && mouse.y !== null) {
            x = particles[i].x - mouse.x;
            y = particles[i].y - mouse.y;
            dist = Math.sqrt(x * x + y * y);

            if (dist < properties.lineLength * 1.2) {
              ctx.lineWidth = 0.8;
              ctx.strokeStyle = `rgba(255, 255, 255, ${(1 - dist / (properties.lineLength * 1.2)) * 0.4})`;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(mouse.x, mouse.y);
              ctx.closePath();
              ctx.stroke();
            }
          }
        }
      }

      function loop() {
        ctx.clearRect(0, 0, width, height);

        for (let i = 0; i < particles.length; i++) {
          particles[i].position();
          particles[i].draw();
        }
        drawLines();
        requestAnimationFrame(loop);
      }

      function init() {
        resizeCanvas();
        particles = [];
        for (let i = 0; i < properties.particleCount; i++) {
          particles.push(new Particle());
        }
        loop();
      }

      window.addEventListener("resize", init);
      init();
    }

    document.addEventListener("astro:page-load", initHackingNetwork);
  </script>
</footer>
