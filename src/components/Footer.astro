---
import { Icon } from "astro-icon/components";

interface Social {
  title: string;
  link: string;
}

const socials = [
  { title: "github", link: "https://github.com/orodrigojose" },
  { title: "linkedin", link: "https://linkedin.com/in/orodrigojose" },
];
---

<footer
  class="relative flex items-center justify-center text-neutral-500 py-16 px-6 overflow-hidden border-t-2 border-neutral-600/20 group mt-25 w-full"
>
  <div class="relative max-w-7xl mx-auto z-10 font-mono">
    <div>
      <span>Rodrigo Jose - 2026 &copy;</span>
    </div>
    <ul class="flex gap-4 border-t-2 border-t-neutral-800/40 p-2">
      {
        socials.map((social: Social, index: number) => (
          <a
            href={social.link}
            aria-label={social.title}
            class="text-lg hover:text-white hover:scale-105 transition-all"
          >
            <Icon name={`mdi:${social.title}`} aria-hidden="true" />
          </a>
        ))
      }
    </ul>
  </div>
</footer>
