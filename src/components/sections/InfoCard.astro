---
import Stacks from "../Stacks.astro";

interface Props {
  name: string;
  local: string;
}

const { name, local } = Astro.props;
---

<div
  class="relative block overflow-hidden border border-neutral-400 p-4 sm:p-6 lg:p-8"
>
  <div class="w-full">
    <div class="text-gray-50 flex justify-between items-center">
      <h1 class="text-4xl pr-2 sm:text-4xl font-bold">
        {name}
      </h1>
      <div class="flex gap-1 sm:gap-3"></div>
    </div>
    <p class="mt-1 font-medium text-gray-500 text-xl">{local}</p>
    <div class="mt-4">
      <p class="text-pretty text-lg sm:text-xl text-neutral-50">
        <slot />
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="/projects"
          class="border border-neutral-500 px-4 py-2 text-sm text-neutral-200 transition hover:border-white hover:text-white"
        >
          View projects
        </a>
        <a
          href="/contact"
          class="bg-neutral-200 px-4 py-2 text-sm text-neutral-950 transition hover:bg-white"
        >
          Contact me
        </a>
      </div>
      <Stacks />
    </div>
  </div>
</div>
